---
import ArrowUp from "@lucide/astro/icons/arrow-up";
---

<button data-scroll-top class="scroll-top-desktop" type="button" aria-label="Scroll to top">
  Back to top
  <ArrowUp stroke-width={2} aria-hidden="true" />
</button>

<button data-scroll-top class="scroll-top-mobile" type="button" aria-label="Scroll to top">
  <ArrowUp stroke-width={2} aria-hidden="true" />
</button>

<script>
  function sync() {
    const show = window.scrollY > 400;
    document
      .querySelectorAll("[data-scroll-top]")
      .forEach((button) => button.classList.toggle("visible", show));
  }

  window.addEventListener("scroll", sync, { passive: true });

  // The buttons are replaced on client-side navigation, so bind per page load.
  document.addEventListener("astro:page-load", () => {
    document.querySelectorAll("[data-scroll-top]").forEach((button) =>
      button.addEventListener("click", () => window.scrollTo({ top: 0, behavior: "smooth" }))
    );
    sync();
  });
</script>
