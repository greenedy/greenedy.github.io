---
import ArrowUpRight from "@lucide/astro/icons/arrow-up-right";

interface Props {
  href: string;
  label: string;
}

const { href, label } = Astro.props;
---

<a class="card" href={href} target="_blank" rel="noopener noreferrer">
  <span class="card-label">
    <slot />
    {label}
  </span>
  <ArrowUpRight class="card-arrow" stroke-width={1.4} aria-hidden="true" />
</a>
