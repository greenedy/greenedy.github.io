---
import AsciiBackdrop from "../components/AsciiBackdrop.astro";
import Header from "../components/Header.astro";
import ScrollToTop from "../components/ScrollToTop.astro";
import { ClientRouter } from "astro:transitions";
import "@fontsource/karla/400.css";
import karlaWoff2 from "@fontsource/karla/files/karla-latin-400-normal.woff2?url";
import "../styles/global.css";

interface Props {
  title?: string;
  description?: string;
}

const {
  title = "Dylan Greene",
  description = "Dylan Greene is a software engineer at the Canada Border Services Agency, working full-stack and mostly on AWS.",
} = Astro.props;

const isHome = (Astro.url.pathname.replace(/\/$/, "") || "/") === "/";
const canonical = new URL(Astro.url.pathname, Astro.site).href;
const ogImage = new URL("/og.png", Astro.site).href;

const person = {
  "@context": "https://schema.org",
  "@type": "Person",
  name: "Dylan Greene",
  url: new URL("/", Astro.site).href,
  jobTitle: "Software Engineer",
  worksFor: { "@type": "Organization", name: "Canada Border Services Agency" },
  alumniOf: { "@type": "CollegeOrUniversity", name: "University of Ottawa" },
  sameAs: [
    "https://github.com/greenedy",
    "https://www.linkedin.com/in/greenedy",
    "https://x.com/Greeenedy",
    "https://youtube.com/@greeenedy",
  ],
};

// Baked in at build time; the script below keeps it right if the site sits
// unbuilt across New Year.
const year = new Date().getFullYear();
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    {/* Fetch the font up front so the first paint isn't in the wider fallback
        font, which reflows the text when Karla swaps in. */}
    <link rel="preload" href={karlaWoff2} as="font" type="font/woff2" crossorigin />

    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />

    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content="Dylan Greene" />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Dylan Greene, Software Engineer" />
    <meta name="twitter:card" content="summary_large_image" />

    <link rel="sitemap" href="/sitemap-index.xml" />
    {isHome && <script type="application/ld+json" is:inline set:html={JSON.stringify(person)} />}

    <ClientRouter />

    {/* is:inline keeps this unbundled so it runs before first paint. */}
    <script is:inline>
      (function () {
        function apply() {
        try {
          var stored = localStorage.getItem("theme");
          var theme = stored === "light" || stored === "dark" ? stored : "system";
          var prefersDark = window.matchMedia("(prefers-color-scheme: dark)").matches;
          document.documentElement.dataset.theme = theme;
          document.documentElement.classList.toggle(
            "dark",
            theme === "dark" || (theme === "system" && prefersDark)
          );
        } catch (e) {
          document.documentElement.dataset.theme = "system";
          if (window.matchMedia("(prefers-color-scheme: dark)").matches) {
            document.documentElement.classList.add("dark");
          }
        }
        }

        apply();
        // Client-side navigation replaces the attributes on <html>; put the
        // theme back before the new page paints.
        document.addEventListener("astro:after-swap", apply);
      })();
    </script>
  </head>

  <body data-page={isHome ? "home" : "page"}>
    <AsciiBackdrop />

    <Header />

    <main class="wrap">
      <slot />
      <ScrollToTop />
    </main>

    <footer class="site-footer wrap">
      <span><span data-year>{year}</span> Dylan Greene</span>
    </footer>

    <script>
      // astro:page-load fires on first load and after every client-side navigation.
      document.addEventListener("astro:page-load", () => {
        const year = String(new Date().getFullYear());
        document.querySelectorAll("[data-year]").forEach((el) => {
          el.textContent = year;
        });
      });
    </script>
  </body>
</html>
